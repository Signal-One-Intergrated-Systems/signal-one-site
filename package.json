{
  "name": "signal-one-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:branding": "node scripts/check-branding.mjs",
    "prebuild": "npm run check:branding",
    "check:built": "node scripts/check-branding.mjs --built",
    "postbuild": "npm run check:built",
    "qa": "npm run build && playwright test",
    "qa:run": "playwright test",
    "qa:docker": "docker build -f Dockerfile.qa -t signal-one-qa . && docker run --rm signal-one-qa"
  },
  "dependencies": {
    "next": "16.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5"
  }
}
