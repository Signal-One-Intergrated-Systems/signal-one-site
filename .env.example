# Canonical public URL (metadata, sitemap, robots). Defaults to https://signalone.co.za
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID. Analytics stay dormant when unset.
NEXT_PUBLIC_GA_ID=

# Public form hand-off (server-side only). /api/intake answers 503 while unset.
SIGNAL_ONE_INTAKE_URL=
SIGNAL_ONE_INTAKE_TOKEN=

# Sales recruitment on /join/sales (read at request time).
#   SALES_RECRUITMENT_STATUS: open | closed   (unset = open)
#   SALES_OPEN_ROLES: positive integer        (unset = no count shown)
#   SALES_OS_URL: https sign-in URL for existing representatives (unset = placeholder)
SALES_RECRUITMENT_STATUS=
SALES_OPEN_ROLES=
SALES_OS_URL=
